# Frontend image: nginx serving the static web UI + reverse-proxying /api to
# the cleaning service. No build step — the UI is plain HTML/CSS/JS.
#
# Build from the repository root:
#   docker build -f deploy/Dockerfile.web -t ai-watermark-remover-web .

FROM nginx:1.27-alpine

# Reverse-proxy + static config.
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Static UI.
COPY web/ /usr/share/nginx/html/

EXPOSE 80

# nginx runs in the foreground by default in this image.
