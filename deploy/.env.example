# Copy this file to `.env` in the deploy/ directory, then edit.
# `docker compose` auto-loads it. Everything here is OPTIONAL —
# the app cleans files out of the box with none of it set.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# 1) API KEY  (the main thing you might want to set)
# ---------------------------------------------------------------------------
# Leave EMPTY for an open service (fine for local testing).
# Set a long random value to lock the API down: every request must then send
# `Authorization: Bearer <this-value>`. Paste the SAME value into the web UI
# under Settings -> "API key".
#
# Generate one with:   openssl rand -hex 32
WATERMARKS_SERVER_API_KEY=

# ---------------------------------------------------------------------------
# 2) Web UI host port
# ---------------------------------------------------------------------------
# The port you open in the browser. 8080 by default; use 80 on a public server.
WEB_PORT=8080

# ---------------------------------------------------------------------------
# 3) Version label shown in the UI header (cosmetic)
# ---------------------------------------------------------------------------
WATERMARKS_SERVER_VERSION=1.0.0

# ---------------------------------------------------------------------------
# 4) Optional: SynthID image scoring sidecar
# ---------------------------------------------------------------------------
# Only needed if you run the heavy "wr-synthid-score" service from the upstream
# compose stack. Leave empty otherwise.
WATERMARKS_SYNTHID_SCORER_URL=
WATERMARKS_SYNTHID_SCORER_API_KEY=
